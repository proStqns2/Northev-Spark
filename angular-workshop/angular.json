{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "northev-workshop": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ws",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              "src/public"
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4300,
            "host": "0.0.0.0",
            "proxyConfig": "proxy.conf.json",
            "allowedHosts": [
              "4300-ig8s3n6f32vcxpal5djbx.e2b.app",
              "localhost",
              "127.0.0.1"
            ]
          },
          "configurations": {
            "production": {
              "buildTarget": "northev-workshop:build:production"
            },
            "development": {
              "buildTarget": "northev-workshop:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
