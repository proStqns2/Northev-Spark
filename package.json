{
  "name": "northev-spark",
  "version": "1.0.0",
  "private": true,
  "description": "Northev Spark — studio de circuits électriques, équivalents Thévenin / Norton, multiwork temps réel et agents IA.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/engine/solver.test.ts lib/collab/channel.test.ts lib/studio/doc.test.ts components/studio/equivalent.render.test.tsx lib/api/hardening.test.ts lib/studio/editor.test.ts",
    "verify": "tsx scripts/verify-engine.ts",
    "check:ui": "node scripts/errors-check.mjs",
    "check:clicks": "node scripts/interact-check.mjs",
    "serve": "node scripts/serve.mjs",
    "check:studio": "node scripts/studio-check.mjs",
    "analytics:demo": "python3 analytics/spark_academy.py --input analytics/data/demo.jsonl --sample",
    "mongo:dry": "node scripts/mongo-migrate.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "perfect-cursors": "^1.0.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
