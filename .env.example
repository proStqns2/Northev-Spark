# ─────────────────────────────────────────────────────────────────────────────
#  Northev Spark — configuration
#  Copiez ce fichier en `.env.local` et renseignez vos clés.
#  Aucune clé n'est nécessaire pour démarrer en mode démo local.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Supabase (historique cloud des comptes et des montages)
#    Schéma : exécutez supabase/schema.sql dans l'éditeur SQL du projet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Agents IA premium (facultatif : sans clé, le moteur local raisonne seul)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Stockage local du mode démo (chemin du fichier JSON)
# DATA_DIR=./.data
